{
  "name": "accountuitive-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true});\"",
    "dev": "next dev --turbopack",
    "build": "npm --prefix web ci --include=dev && npm --prefix web run build && next build",
    "dev:web": "npm --prefix web run dev",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "db:apply-inventory": "node scripts/js/apply-sql-file.mjs",
    "db:apply-report-category": "node scripts/js/apply-sql-file.mjs database/migrations_v2/007_accounts_report_category.sql",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neon/auth": "^0.8.2",
    "next": "^16.2.4",
    "postgres": "^3.4.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@types/node": "20.9.0",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "dotenv": "^16.4.5",
    "tsx": "^4.23.15",
    "typescript": "5.3.2"
  }
}
