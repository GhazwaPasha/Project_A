# Copy to `.env` at the repository root. Next.js (`web-app/`) and command-api load env from here.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# Neon / Postgres (web-app server routes + command-api)
# -----------------------------------------------------------------------------
# Pooled connection string from Neon (dev/staging/prod branches each have their own URL).
DATABASE_URL=

# Optional: separate URL for long-running migration tools (non-serverless).
# DATABASE_URL_UNPOOLED=

# -----------------------------------------------------------------------------
# Neon Auth (Next.js `web-app/`) — see https://neon.tech/docs/neon-auth/quick-start/nextjs
# -----------------------------------------------------------------------------
# Managed auth endpoint URL from the Neon project (Neon Auth / Integrations).
NEON_AUTH_BASE_URL=

# Secret for signing session cookies (min 32 chars). Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# -----------------------------------------------------------------------------
# Command API (`services/command-api/`) + Next.js BFF proxy (`/api/commands/*`)
# -----------------------------------------------------------------------------
# Base URL where command-api listens (no trailing slash required).
COMMAND_API_URL=http://127.0.0.1:8787

# Shared secret: must match on both Next.js and command-api (not exposed to browsers).
COMMAND_API_SECRET=

# When `true`, posting a v2 journal also inserts legacy `journal_entries` / `journal_entry_lines`.
# DUAL_WRITE_LEGACY_JOURNAL=false

# -----------------------------------------------------------------------------
# Supabase (interim server-only: `DataServiceAdmin` / service role until full Neon port)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Optional: scripts / local Postgres (Python tooling)
# -----------------------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Optional: AI features
MISTRAL_API_KEY=
