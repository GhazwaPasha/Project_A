# Copy to `.env` at the repository root. Next.js loads env from here via `next.config.js`.
# Never commit real secrets.
#
# Keep variables in the root `.env` (and optional `.env.local` / mode-specific files).
#
# Greenfield: create a new Neon branch, run `database/greenfield_bootstrap.sql`, enable Neon Auth,
# then set `DATABASE_URL`, `NEON_AUTH_BASE_URL`, and `NEON_AUTH_COOKIE_SECRET` before starting the app.

# -----------------------------------------------------------------------------
# Neon / Postgres (Next.js server routes)
# -----------------------------------------------------------------------------
# Pooled connection string from Neon (dev/staging/prod branches each have their own URL).
# In the Neon console: Project → Connect → copy the *Postgres* (psql/Node) string.
# The host should look like ep-…-pooler.….aws.neon.tech — if you see "apirest" in the host, that is the wrong (non-Postgres) endpoint; pick the standard connection string instead.
DATABASE_URL=

# Optional: separate URL for long-running migration tools (non-serverless).
# DATABASE_URL_UNPOOLED=

# -----------------------------------------------------------------------------
# Neon Auth (Next.js) — see https://neon.tech/docs/neon-auth/quick-start/nextjs
# -----------------------------------------------------------------------------
# Managed auth endpoint URL from the Neon project (Neon Auth / Integrations).
NEON_AUTH_BASE_URL=

# Secret for signing session cookies (min 32 chars). Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# AI provider for the agent (server only; never prefix with NEXT_PUBLIC_).
# Works with any provider offering an OpenAI-compatible chat API.
# AGENT_PROVIDER: google | anyrouter | openai | anthropic | groq | openrouter | ollama, or leave blank and set AGENT_BASE_URL.
# With no AGENT_PROVIDER set, GOOGLE_AI_KEY is used if present, then ANYROUTER_API_KEY.
# google uses gemini-3.8-flash and anyrouter uses anyrouter/free unless AGENT_MODEL says otherwise.
GOOGLE_AI_KEY=
ANYROUTER_API_KEY=
AGENT_PROVIDER=
AGENT_MODEL=
AGENT_API_KEY=
AGENT_BASE_URL=
